# ===================================================
# SMO APPLICATION - ENVIRONMENT VARIABLES TEMPLATE
# ===================================================
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file with real values
# ===================================================

# ===================================================
# DATABASE CONFIGURATION
# ===================================================

# MySQL Connection URL (with SSL enabled for production)
DB_URL=jdbc:mysql://localhost:3306/PALMSV1?useSSL=true&serverTimezone=UTC

# Database Username (use limited privileges user)
DB_USERNAME=palms_app

# Database Password (strong password, min 16 characters)
DB_PASSWORD=your_strong_db_password_here_min_16_chars

# ===================================================
# JWT CONFIGURATION
# ===================================================

# JWT Secret Key (CRITICAL - min 256 bits)
# Generate with: openssl rand -base64 32
# Or with: java -cp target/smo.jar com.cutm.smo.util.EncryptionUtil
JWT_SECRET=your_256bit_base64_encoded_jwt_secret_here_min_44_chars

# JWT Token Expiration (milliseconds)
# 86400000 = 24 hours
JWT_EXPIRATION=86400000

# JWT Refresh Token Expiration (milliseconds)
# 604800000 = 7 days
JWT_REFRESH_EXPIRATION=604800000

# ===================================================
# ENCRYPTION CONFIGURATION
# ===================================================

# AES-256 Encryption Key (CRITICAL - min 256 bits)
# Generate with: java -cp target/smo.jar com.cutm.smo.util.EncryptionUtil
# This encrypts sensitive data like Aadhar, PAN, Salary, etc
ENCRYPTION_KEY=your_base64_aes256_key_here_min_44_chars

# Enable/Disable Encryption
encryption.enabled=true

# ===================================================
# CORS CONFIGURATION
# ===================================================

# Allowed Origins (comma-separated, no wildcards)
# Examples: https://yourdomain.com, https://api.yourdomain.com, http://localhost:4200
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com,http://localhost:4200

# CORS Max Age (seconds)
# How long browser caches CORS preflight responses
CORS_MAX_AGE=3600

# ===================================================
# SECURITY CONFIGURATION
# ===================================================

# Enable/Disable Swagger UI
# IMPORTANT: Set to false in production!
SWAGGER_ENABLED=false

# Enforce HTTPS only
# IMPORTANT: Set to true in production!
ENABLE_HTTPS_ONLY=true

# ===================================================
# APPLICATION CONFIGURATION
# ===================================================

# Application Name
spring.application.name=palms

# Server Port
server.port=8080

# Server Address (0.0.0.0 = accessible from any host)
server.address=0.0.0.0

# Logging Level
logging.level.root=INFO
logging.level.com.cutm.smo=DEBUG
logging.level.org.hibernate=WARN

# ===================================================
# DATABASE POOL CONFIGURATION
# ===================================================

# Maximum Pool Size (max connections to database)
spring.datasource.hikari.maximum-pool-size=20

# Minimum Idle (min idle connections)
spring.datasource.hikari.minimum-idle=5

# Connection Timeout (milliseconds)
spring.datasource.hikari.connection-timeout=20000

# Idle Timeout (milliseconds)
spring.datasource.hikari.idle-timeout=300000

# Max Lifetime (milliseconds)
spring.datasource.hikari.max-lifetime=1200000

# ===================================================
# JPA/HIBERNATE CONFIGURATION
# ===================================================

# Hibernate DDL Auto
# validate = check schema matches entities (production safe)
spring.jpa.hibernate.ddl-auto=validate

# Show SQL (disable in production for performance)
spring.jpa.show-sql=false

# Format SQL (disable in production for performance)
spring.jpa.properties.hibernate.format_sql=false

# Open In View (disable in production)
spring.jpa.open-in-view=false

# ===================================================
# FLYWAY MIGRATION CONFIGURATION
# ===================================================

# Enable Flyway
spring.flyway.enabled=true

# Flyway Locations
spring.flyway.locations=classpath:db/migration

# ===================================================
# OPTIONAL: PRODUCTION MONITORING
# ===================================================

# Actuator Endpoints (for health checks, metrics)
management.endpoints.web.exposure.include=health,metrics,info
management.endpoint.health.show-details=when-authorized

# Health Check Endpoint
# http://yourdomain:8080/actuator/health

# ===================================================
# OPTIONAL: KUBERNETES / DOCKER DEPLOYMENT
# ===================================================

# If using Kubernetes, set these:
# spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect
# spring.datasource.hikari.auto-commit=false

# ===================================================
# HOW TO DEPLOY
# ===================================================

# Option 1: Using Environment Variables
# ============================================
# export DB_URL="jdbc:mysql://localhost:3306/PALMSV1?useSSL=true&serverTimezone=UTC"
# export DB_USERNAME="palms_app"
# export DB_PASSWORD="strong_password"
# export JWT_SECRET="base64_key_here"
# export ENCRYPTION_KEY="base64_aes256_key"
# export CORS_ALLOWED_ORIGINS="https://yourdomain.com"
# export SWAGGER_ENABLED="false"
# export ENABLE_HTTPS_ONLY="true"
# java -jar target/smo-V0.1.war

# Option 2: Using application-prod.properties
# ============================================
# Create: src/main/resources/application-prod.properties
# Copy all values from this file to application-prod.properties
# java -jar target/smo-V0.1.war --spring.profiles.active=prod

# Option 3: Docker / Kubernetes
# ============================================
# See DEPLOYMENT_READY.md for Docker/K8s setup

# ===================================================
# SECURITY BEST PRACTICES
# ===================================================

# 1. NEVER commit actual .env file to repository
# 2. Use AWS Secrets Manager / HashiCorp Vault for secrets management
# 3. Rotate JWT_SECRET and ENCRYPTION_KEY regularly
# 4. Use strong, random passwords (min 16 chars)
# 5. Keep SWAGGER_ENABLED=false in production
# 6. Keep ENABLE_HTTPS_ONLY=true in production
# 7. Monitor database connection pool usage
# 8. Restrict CORS_ALLOWED_ORIGINS to only necessary domains
# 9. Use separate database users for dev/staging/prod
# 10. Enable database backups and test recovery procedures

# ===================================================
# GENERATE RANDOM SECRETS
# ===================================================

# Generate JWT_SECRET (256-bit Base64):
# openssl rand -base64 32

# Generate ENCRYPTION_KEY (AES-256 Base64):
# java -cp target/smo.jar com.cutm.smo.util.EncryptionUtil

# Generate strong password:
# openssl rand -base64 16

# ===================================================
